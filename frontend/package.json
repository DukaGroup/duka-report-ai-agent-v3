{
  "name": "duka-report-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src index.html vite.config.ts",
    "test": "node --test ../tests/voice.test.mjs ../tests/subscription-recovery.test.mjs ../tests/chat-timeline.test.mjs ../tests/conversation-runs.test.mjs ../tests/markdown-tables.test.mjs"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
