# Fresh native installation only. Do not replace an existing runtime.env.
APP_ENV=production
ALLOWED_ORIGINS=https://hana.dukagroup.local
SECURE_COOKIES=true
SESSION_HOURS=0
VOICE_ENABLED=false
TURN_TIMEOUT_SECONDS=0
MAX_CODEX_RUNTIMES=4
MAX_CODEX_WORKERS=4
# Configure data sources in Hana or retain your existing database settings.
# TLS verification is optional; a supplied trusted certificate enables it.
SQLSERVER_ENCRYPTION=require
SQLSERVER_VALIDATE_CERTIFICATE=false
SQLSERVER_TLS_CA_CERTIFICATE=
SQLSERVER_TLS_SERVER_NAME=
HANA_ENCRYPT=true
HANA_VALIDATE_CERTIFICATE=false
