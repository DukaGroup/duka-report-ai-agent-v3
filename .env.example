# Copy to .env if you want to override defaults. Never store ChatGPT credentials here.
PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECURE_COOKIES=false
SESSION_HOURS=24
VOICE_ENABLED=true
WHISPER_MODEL=base
# Leave empty for language detection, or set an ISO language code such as en or sq.
WHISPER_LANGUAGE=
MAX_CODEX_RUNTIMES=8
TURN_TIMEOUT_SECONDS=300

# Backend only; never delivered to the browser or the Codex child process.
# When configured, these values take precedence over old form-saved credentials.
# After editing .env, run: docker compose up -d --force-recreate
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DATABASE=
SQLSERVER_ENCRYPTION=require
SQLSERVER_TIMEOUT_SECONDS=15
