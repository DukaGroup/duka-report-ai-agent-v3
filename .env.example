# Local development: copy to the ignored .env. Native production uses
# /var/lib/duka-agent/runtime.env. Never commit credentials or financial files.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECURE_COOKIES=false
# 0 keeps users signed in until logout/account revocation; the browser cookie renews while the app is used.
SESSION_HOURS=0
VOICE_ENABLED=true
WHISPER_MODEL=base
# Leave empty for language detection, or set an ISO language code such as en or sq.
WHISPER_LANGUAGE=
MAX_CODEX_RUNTIMES=8
# 0 lets ChatGPT/Claude investigations run until completion or Stop.
TURN_TIMEOUT_SECONDS=0

# Backend only; never delivered to the browser or the Codex child process.
# These values take precedence for the first/default SQL source.
# Other sources with saved credentials retain their distinct connections.
# Admin-saved connections are written here with DUKA_CONNECTION_<ID>_ prefixes.
# Do not rename those prefixes; blank form fields retain saved values.
# Native production reads /var/lib/duka-agent/runtime.env as the duka user.
# After manual production changes: sudo systemctl restart duka-agent
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Optional: leave empty to discover all accessible business databases on the server.
SQLSERVER_DATABASE=
# Optional dedicated profile for the source named GoTech. If any key is set,
# supply the whole profile; it overrides SQLSERVER_* for GoTech only.
# GOTECH_SQLSERVER_HOST=
# GOTECH_SQLSERVER_PORT=1433
# GOTECH_SQLSERVER_USER=
# GOTECH_SQLSERVER_PASSWORD=
# GOTECH_SQLSERVER_DATABASE=
# Other named profiles use the uppercase source name with spaces/punctuation
# replaced by underscores, followed by _SQLSERVER_HOST/PORT/USER/PASSWORD/DATABASE.
# Same TLS policy in development and production. A supplied trusted PEM
# certificate forces encryption and verification; without verification the
# server identity is not checked. SQL Server request mode permits plaintext.
SQLSERVER_ENCRYPTION=require
SQLSERVER_VALIDATE_CERTIFICATE=false
SQLSERVER_TLS_CA_CERTIFICATE=
SQLSERVER_TLS_SERVER_NAME=
# Login/connect limit. Running queries (SQL Server and HANA) use the longer
# DATABASE_QUERY_TIMEOUT_SECONDS so large companies are not cut off.
SQLSERVER_TIMEOUT_SECONDS=15
DATABASE_QUERY_TIMEOUT_SECONDS=600
# Threads for blocking database/file work shared by all users.
BLOCKING_THREADS=64

# Optional default SAP HANA environment profile. Additional HANA connections
# have their own DUKA_CONNECTION_<ID>_HANA_* keys managed by the admin form.
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
# Optional tenant database; SAP Business One companies are schemas, not tenants.
HANA_DATABASE=
HANA_ENCRYPT=true
HANA_VALIDATE_CERTIFICATE=false
# Optional trusted CA chain from your SAP HANA administrator, stored as a
# single-quoted multiline PEM value. Never paste private keys.
HANA_TLS_CA_CERTIFICATE=
# Optional verified DNS identity in the certificate when connecting by IP.
HANA_TLS_SERVER_NAME=

# Concurrent independent chat/report processes; idle workers are evicted.
MAX_CODEX_WORKERS=16

# Full Excel export capacity (per result and total immutable snapshot).
# Exceeding these limits fails the report; rows and breakdowns are never omitted.
REPORT_MAX_ROWS=1000000
REPORT_MAX_BYTES=250000000
WORKBOOK_SCRIPT_TIMEOUT_SECONDS=300
WORKBOOK_SCRIPT_MEMORY_MB=4096
